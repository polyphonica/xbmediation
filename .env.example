# Local dev: a local Postgres instance (see README for setup).
# Production (IONOS VPS): a native Postgres instance running on the same
# server, listening on localhost only — set a real password when you create
# the role there, and use it here instead of "change-me".
DATABASE_URL="postgresql://xbmediation:change-me@localhost:5432/xbmediation"

# Used for sitemap.xml/robots.txt and page metadata.
# Local dev: http://localhost:3000
# Production: https://xb-mediation.de
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Encrypts/signs the /admin login session cookie. Generate a real one with:
#   openssl rand -base64 32
# Must be at least 32 characters. Changing this invalidates all existing
# admin sessions (forces everyone to log in again) — that's expected if it
# ever needs rotating.
SESSION_SECRET="change-me-to-a-real-32-plus-character-random-string"

# SMTP credentials for the kontakt@xb-mediation.de IONOS mailbox, used to
# email the practice about new contact-form submissions (see src/lib/email.ts).
# Leave unset in local dev to skip sending and just log to the console.
# Typical IONOS values: host smtp.ionos.de, port 587 (or 465 for implicit TLS).
SMTP_HOST="smtp.ionos.de"
SMTP_PORT="587"
SMTP_USER="kontakt@xb-mediation.de"
SMTP_PASS="change-me"

# Optional: override which address receives the notification email.
# Defaults to SMTP_USER (the mailbox above) if unset.
CONTACT_NOTIFY_TO="kontakt@xb-mediation.de"
