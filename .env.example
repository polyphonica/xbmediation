# --- Used directly by the Next.js app (via `next dev` / `prisma`) ---

# Local dev: matches docker-compose.override.yml's Postgres service.
# Production (IONOS VPS): points at the "db" service on the internal Docker network.
DATABASE_URL="postgresql://xbmediation:xbmediation@localhost:5432/xbmediation"

# Used for sitemap.xml/robots.txt and page metadata. Update once a domain is registered.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Read by docker-compose.yml itself (variable substitution), same file ---

# Postgres password on the VPS — generate a strong one, never commit the real value.
POSTGRES_PASSWORD="change-me"

# Public site URL baked into the "app" container in production.
SITE_URL="https://xb-mediation.de"
