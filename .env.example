# Local dev: a local Postgres instance (see README for setup).
# Production (IONOS VPS): a native Postgres instance running on the same
# server, listening on localhost only — set a real password when you create
# the role there, and use it here instead of "change-me".
DATABASE_URL="postgresql://xbmediation:change-me@localhost:5432/xbmediation"

# Used for sitemap.xml/robots.txt and page metadata.
# Local dev: http://localhost:3000
# Production: https://xb-mediation.de
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
